rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'michelenico4@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'role']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'role', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.role in ['admin', 'user'] &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidAppConfig(data) {
      return data.keys().hasAll(['id', 'payload']) &&
        data.keys().hasOnly(['id', 'payload', 'updatedBy', 'updatedAt']) &&
        data.id is string && data.id.size() <= 64 &&
        data.payload is string && data.payload.size() <= 100000 &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidReservation(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'date', 'slot', 'guests', 'status']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'phone', 'email', 'date', 'slot', 'guests', 'notes', 'status', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
        data.date is string && data.date.size() <= 30 &&
        data.slot is string && data.slot.size() <= 20 &&
        data.guests is string && data.guests.size() <= 10 &&
        data.status in ['confirmed', 'cancelled'] &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['id', 'code', 'reward', 'status']) &&
        data.keys().hasOnly(['id', 'userId', 'code', 'score', 'reward', 'status', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.code is string && data.code.size() <= 32 &&
        data.reward is string && data.reward.size() <= 200 &&
        data.status in ['active', 'redeemed'] &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        (!('score' in data) || (data.score is number)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // User profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isSignedIn() && request.auth.uid == userId &&
                    isValidUser(incoming()) && incoming().role == 'user';
      allow update: if isValidId(userId) && isSignedIn() && isValidUser(incoming()) && (
        isAdmin() ||
        (request.auth.uid == userId &&
         incoming().role == existing().role &&
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']))
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Admins registry
    match /admins/{adminId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }

    // App configurations (menu, specials, gallery, contacts, booking config, etc.)
    match /appConfig/{configId} {
      allow get, list: if isValidId(configId);
      allow create, update: if isValidId(configId) && isAdmin() && isValidAppConfig(incoming());
      allow delete: if isValidId(configId) && isAdmin();
    }

    // Reservations
    match /reservations/{reservationId} {
      allow get: if isValidId(reservationId) && (
        isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isValidId(reservationId) && isValidReservation(incoming()) && (
        !isSignedIn() || incoming().userId == request.auth.uid || isAdmin()
      );
      allow update: if isValidId(reservationId) && isSignedIn() && isValidReservation(incoming()) && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
         incoming().status == 'cancelled')
      );
      allow delete: if isValidId(reservationId) && isAdmin();
    }

    // Coupons
    match /coupons/{couponId} {
      allow get: if isValidId(couponId) && (
        isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isValidId(couponId) && isValidCoupon(incoming()) && (
        !isSignedIn() || incoming().userId == request.auth.uid || isAdmin()
      );
      allow update: if isValidId(couponId) && isAdmin() && isValidCoupon(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(couponId) && isAdmin();
    }
  }
}
